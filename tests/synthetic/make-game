#!/usr/bin/env python3
"""Write a tiny game project with no Nintendo code in it.

    tests/synthetic/make-game <dir>

<dir> gets main.dol, functions.map, bindings.json and recomp.yml: a project
tools/wiinx-translate and cmake/game take like any other. It proves the whole
path - translate, compile, link, NRO - on any machine, with no disc.

The program, hand-encoded PowerPC:

    main:  calls sum(data, 4), stores the result, doubles a float
    sum:   ctr loop adding words
"""
import json
import os
import struct
import sys

TEXT = 0x80001000
DATA = 0x80600000

MAIN = [
    0x7C0802A6,  # mflr   r0
    0x90010004,  # stw    r0, 4(r1)
    0x9421FFF0,  # stwu   r1, -16(r1)
    0x3C608060,  # lis    r3, DATA@h
    0x38800004,  # li     r4, 4
    0x480000ED,  # bl     sum
    0x3CA08060,  # lis    r5, DATA@h
    0x90650010,  # stw    r3, 0x10(r5)
    0xC0250014,  # lfs    f1, 0x14(r5)
    0xEC21082A,  # fadds  f1, f1, f1
    0xD0250018,  # stfs   f1, 0x18(r5)
    0x80010014,  # lwz    r0, 20(r1)
    0x38210010,  # addi   r1, r1, 16
    0x7C0803A6,  # mtlr   r0
    0x4E800020,  # blr
]
SUM_OFFSET = 0x100
SUM = [
    0x7C8903A6,  # mtctr  r4
    0x38A00000,  # li     r5, 0
    0x80C30000,  # lwz    r6, 0(r3)      <- loop
    0x7CA53214,  # add    r5, r5, r6
    0x38630004,  # addi   r3, r3, 4
    0x4200FFF4,  # bdnz   loop
    0x7CA32B78,  # mr     r3, r5
    0x4E800020,  # blr
]


def dol() -> bytes:
    text = bytearray(SUM_OFFSET + 4 * len(SUM))
    text[0:4 * len(MAIN)] = struct.pack(f">{len(MAIN)}I", *MAIN)
    text[SUM_OFFSET:] = struct.pack(f">{len(SUM)}I", *SUM)
    data = struct.pack(">4I", 1, 2, 3, 4) + struct.pack(">IfI4x", 0, 1.5, 0)

    header = bytearray(0x100)
    text_off = 0x100
    data_off = text_off + len(text)
    struct.pack_into(">I", header, 0x00, text_off)   # text[0] offset
    struct.pack_into(">I", header, 0x48, TEXT)       # text[0] address
    struct.pack_into(">I", header, 0x90, len(text))  # text[0] size
    struct.pack_into(">I", header, 0x1C, data_off)   # data[0] offset
    struct.pack_into(">I", header, 0x64, DATA)       # data[0] address
    struct.pack_into(">I", header, 0xAC, len(data))  # data[0] size
    struct.pack_into(">I", header, 0xD8, DATA + 0x1000)  # bss
    struct.pack_into(">I", header, 0xDC, 0x20)
    struct.pack_into(">I", header, 0xE0, TEXT)       # entry
    return bytes(header + text + data)


def main() -> int:
    if len(sys.argv) != 2:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    out = os.path.abspath(sys.argv[1])
    os.makedirs(out, exist_ok=True)
    libdol = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", ".."))

    with open(os.path.join(out, "main.dol"), "wb") as f:
        f.write(dol())
    with open(os.path.join(out, "functions.map"), "w") as f:
        f.write(f"{TEXT:08x} main\n{TEXT + SUM_OFFSET:08x} sum\n")
    # Binds nothing: every function is the game's own, translated.
    with open(os.path.join(out, "bindings.json"), "w") as f:
        json.dump({}, f)
    with open(os.path.join(out, "recomp.yml"), "w") as f:
        f.write(f"""schema_version: 1
workspace_root: .
project:
  id: synthetic
  display_name: Synthetic
memory:
  base: 0x80000000
  size: 0x01800000
  sda_base: 0x{DATA:08X}
  sda2_base: 0x{DATA:08X}
inputs:
  dol:
    path: main.dol
translation:
  entry_points:
    - 0x{TEXT:08X}
  function_map:
    path: functions.map
  allow_unsupported_instructions: false
runtime:
  native_abi_directories: []
  native_registration_root: {os.path.relpath(os.path.join(libdol, 'src'), out)}
  native_bindings: bindings.json
output:
  root: generated
""")
    print(f"synthetic game written to {out}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
