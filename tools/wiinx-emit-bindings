#!/usr/bin/env python3
"""Write a game's native bindings from its scan, so none are written by hand.

    tools/wiinx-emit-bindings <game folder> [--src DIR]

A native takes effect only if the runtime registers it at the address the game
has, and only if that registration exists before the game is translated - the
translator skips emitting a function it knows is replaced. Writing those
registrations by hand meant a file of near-identical wrappers per module, each
carrying one game's addresses, which is why the library still had Mario Kart
Wii's addresses in it.

This writes them instead, into <game>/native/wiinx_bindings.cpp: one wrapper per
native the game's bindings.json resolved, naming the native and the build it
belongs to. wiinx-translate runs it first, so a game picks up every native the
library has without anyone editing a binding again.
"""
import json
import os
import re
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
NATIVE = re.compile(r'WIINX_NATIVE\(\s*"([^"]+)"\s*,\s*([A-Za-z_][\w:]*)\s*,')
VERSION = re.compile(r'inline constexpr (?:const )?LibVersion\s*&?\s*(\w+)\s*(?:=\s*[\w:.]+;|\{\s*"([^"]+)")')


def library_natives(src_root):
    """[(name, version symbol)] for every native the library registers."""
    found = []
    for root, _, names in os.walk(src_root):
        for name in names:
            if not name.endswith(".cpp"):
                continue
            with open(os.path.join(root, name), errors="ignore") as handle:
                for native, version in NATIVE.findall(handle.read()):
                    found.append((native, version.split("::")[-1]))
    return found


def version_ids(src_root):
    """{version symbol: its id string}, from the module headers."""
    ids = {}
    include = os.path.join(os.path.dirname(src_root), "include", "wiinx", "accel")
    for root, _, names in os.walk(include):
        for name in names:
            with open(os.path.join(root, name), errors="ignore") as handle:
                text = handle.read()
            for symbol, literal in VERSION.findall(text):
                if literal:
                    ids[symbol] = literal
                else:
                    # An alias of a generated build constant: resolve it through
                    # builds.hpp, where every known build has its id.
                    match = re.search(rf"{symbol}\s*=\s*builds::(\w+);", text)
                    if match:
                        ids[symbol] = build_id(match.group(1))
    return ids


def build_id(constant):
    """The id string behind a generated build constant ("nw4r.lyt@2008-03-08")."""
    # (core/builds.hpp; the old path matched nothing, so every native versioned
    # by a build constant - the GX natives - kept the constant's name as its id
    # and never bound)
    text = None
    for header in (os.path.join(HERE, "..", "include", "wiinx", "core", "builds.hpp"),
                   os.path.join(HERE, "..", "include", "wiinx", "builds.hpp")):
        try:
            text = open(header, errors="ignore").read()
            break
        except OSError:
            continue
    if text is None:
        return constant
    pattern = re.escape(constant) + r'\s*\{\s*"([^"]+)"'
    match = re.search(pattern, text)
    return match.group(1) if match else constant


def already_bound(src_root):
    """Natives a hand-written binding already registers: some need setup the
    generated form has no way to know about, so those files stay."""
    names = set()
    for root, _, files in os.walk(src_root):
        for name in files:
            if not name.endswith("_bind.cpp"):
                continue
            with open(os.path.join(root, name), errors="ignore") as handle:
                names.update(re.findall(r'find_native\(\s*"([^"]+)"', handle.read()))
    return names


def load_scan():
    """The scanner, for the build banners a game carries."""
    source = open(os.path.join(HERE, "wiinx-scan")).read()
    module = type(sys)("wiinx_scan")
    module.__dict__["__file__"] = os.path.join(HERE, "wiinx-scan")
    exec(compile(source.replace("def main(argv):", "def _unused(argv):"), "wiinx-scan", "exec"),
         module.__dict__)
    return module


def executable(game):
    """The executable the project translates (recomp.yml inputs.dol.path): a
    disc's main.dol, a WAD title's payload, a NAND title's program. Reading only
    disc/sys/main.dol found nothing for a WAD or NAND title, and the build gate
    below then let every build's natives in."""
    project = os.path.join(game, "recomp.yml")
    if os.path.exists(project):
        match = re.search(r"dol:\s*\n\s*path:\s*(\S+)", open(project, errors="ignore").read())
        if match and os.path.exists(os.path.join(game, match.group(1))):
            return os.path.join(game, match.group(1))
    fallback = os.path.join(game, "disc", "sys", "main.dol")
    return fallback if os.path.exists(fallback) else None


def linked_builds(game):
    """The build ids this game's executable names in its startup banners."""
    dol = executable(game)
    if dol is None:
        return None
    scan = load_scan()
    return {build_id for build_id, _ in scan.builds(scan.Dol(dol)).values()}


def function_extent(game, address):
    """Where the function at `address` ends, from the game's own function map."""
    starts = sorted({a for a, _ in symbol_map(game)} | set(map_starts(game)))
    later = [a for a in starts if a > address]
    return min(later[0] if later else address + 0x2000, address + 0x2000)


def map_starts(game):
    path = os.path.join(game, "functions.map")
    found = []
    if os.path.exists(path):
        for line in open(path, errors="ignore"):
            parts = line.split()
            if parts and re.fullmatch(r"[0-9A-Fa-f]{8}", parts[0]):
                found.append(int(parts[0], 16))
    return found


def call_sites(game, address):
    """The address after each bctrl in the function at `address`, in code
    order: where the original's nth indirect call returns. A native calling the
    game back through a vtable leaves lr there (wiinx::Bound::call)."""
    dol_path = executable(game)
    if dol_path is None:
        return []
    scan = load_scan()
    dol = scan.Dol(dol_path)
    end = function_extent(game, address)
    code = dol.read(address, end - address)
    if code is None:
        return []
    return [address + i + 4 for i in range(0, len(code) - 3, 4)
            if code[i:i + 4] == b"\x4e\x80\x04\x21"]  # bctrl


def direct_calls(game, address):
    """(target, return address) of each `bl` in the function at `address`, in
    code order: where a native calling the same game function the original
    calls leaves lr (wiinx::Bound::returning_from)."""
    dol_path = executable(game)
    if dol_path is None:
        return []
    scan = load_scan()
    dol = scan.Dol(dol_path)
    end = function_extent(game, address)
    code = dol.read(address, end - address)
    found = []
    for i in range(0, len(code or b"") - 3, 4):
        word = int.from_bytes(code[i:i + 4], "big")
        if word >> 26 == 18 and word & 3 == 1:  # bl (relative, linking)
            offset = word & 0x03FFFFFC
            if offset & 0x02000000:
                offset -= 0x04000000
            found.append(((address + i + offset) & 0xFFFFFFFF, address + i + 4))
    return found


def public_names(signatures):
    """{registration: names a signature gives it}: GX__Begin_8016f0f0 is GXBegin
    and GX::Begin, so a native asks for the game's GXBegin by that name."""
    names = {}
    for entry in signatures:
        registration = entry.get("registration")
        if registration and entry.get("name") and not re.fullmatch(r"(0x)?[0-9A-Fa-f]{8}", entry["name"]):
            names.setdefault(registration, set()).add(entry["name"])
    return names


def builds_by_game():
    """{game id: {library: build id}} from data/builds.json's seen_in lists."""
    table = {}
    document = json.load(open(os.path.join(HERE, "..", "data", "builds.json")))
    for build in document["builds"]:
        library = build["id"].split("@")[0]
        for game_id in build.get("seen_in", []):
            table.setdefault(game_id, {})[library] = build["id"]
    return table


def inferred_builds(game, bindings, linked, gated):
    """Builds of libraries the game names no banner for, proven from its code.

    A native written for one build relies on that build's struct layout. A
    library a game links without a banner (Bomberman Blast's nw4r.lyt) still has
    a layout, and its code says which: where the game's function bound to such a
    native uses exactly the struct fields (wiinx-scan field_fingerprint) of that
    native's signature taken from a game whose banner names build B of the
    native's own library, the game's copy is laid out as B. Only the native's
    own library is inferred, and two candidate builds mean none is.
    `gated` is [(native name, build id)] for the natives a build decides.
    Returns ({library: build id}, {library: why})."""
    dol_path = executable(game)
    if dol_path is None:
        return {}, {}
    scan = load_scan()
    dol = scan.Dol(dol_path)
    by_game = builds_by_game()
    banner_libraries = {b.split("@")[0] for b in (linked or ())}
    signatures = json.load(open(os.path.join(HERE, "..", "data", "signatures.json")))["natives"]
    candidates, evidence = {}, {}
    for name, version_id in gated:
        library = version_id.split("@")[0]
        if library in banner_libraries or version_id.endswith("@any"):
            continue
        address = bindings.get(name) or bindings.get(f"{name}@{version_id}")
        if not address:
            continue
        for signature in signatures:
            if signature.get("registration") != name or not signature.get("fields"):
                continue
            code = dol.read(int(address, 16), signature["size"])
            if code is None or scan.field_fingerprint(code) != signature["fields"]:
                continue
            sources = signature["signed_from"]
            for source in sources if isinstance(sources, list) else [sources]:
                build = by_game.get(source, {}).get(library)
                if build:
                    candidates.setdefault(library, set()).add(build)
                    evidence.setdefault(library, f"{name} uses {source}'s fields")
    # Builds that agree field for field on everything this game's code shows
    # are the same layout as far as any native here can tell: Mario Kart Wii's
    # 2008 lyt and New Super Mario Bros. Wii's 2009 one both fit Bomberman
    # Blast's. Then the build with natives for the most of the game's bound
    # functions is taken, the earliest on a tie - not none, which withheld
    # every lyt native from it.
    def covered(build):
        return sum(1 for name, version_id in gated if version_id == build
                   and (bindings.get(name) or bindings.get(f"{name}@{version_id}")))
    inferred = {}
    for library, builds in candidates.items():
        released = package_release(library, linked)
        def distance(build):  # days from the package's release, when it has one
            return abs((day(build) - released).days) if released else 0
        inferred[library] = sorted(builds, key=lambda b: (-covered(b), distance(b), b))[0]
        if released:
            evidence[library] += f"; its package ({library.split('.')[0]}) is of {released.isoformat()}"
        if len(builds) > 1:
            evidence[library] += f"; also fits {', '.join(sorted(builds - {inferred[library]}))}"
    return inferred, {library: evidence[library] for library in inferred}


def day(build_id):
    """The date a build id carries: nw4r.lyt@2008-03-08 -> 2008-03-08."""
    import datetime
    return datetime.date.fromisoformat(build_id.split("@")[1])


def package_release(library, linked):
    """When the package a banner-less library came in was built, from its
    siblings' banners. nw4r ships as one release: Bomberman Blast's EF, G3D and
    SND all say Nov 15 2007 and its LYT says nothing (no banner in the
    executable, so it never tells the console either) - its LYT is that
    release's. None when the siblings disagree or there are none."""
    package = library.split(".")[0]
    dates = {day(b) for b in (linked or ()) if b.startswith(package + ".") and not b.startswith(library + "@")}
    return next(iter(dates)) if len(dates) == 1 else None


def canonical(name):
    """A name as either side spells it: MTX::PSMTXConcat and PSMTXConcat."""
    name = name.split("::")[-1]
    name = re.split(r"__[A-Z0-9]", name)[0]
    return name.replace("_", "").lower()


def symbol_map(game):
    """[(address, name)] from whatever map the game's project names, if any."""
    project = os.path.join(game, "recomp.yml")
    if not os.path.exists(project):
        return []
    text = open(project, errors="ignore").read()
    match = re.search(r"function_map:\s*\n\s*path:\s*(\S+)", text)
    # The configured map may be the one the scanner found, which has addresses
    # and no names; a game whose symbols someone published keeps that beside it
    # as MAP.txt, and names are the point here.
    candidates = [os.path.join(game, "MAP.txt")]
    if match:
        candidates.insert(0 if match.group(1).endswith("MAP.txt") else 1,
                          os.path.join(game, match.group(1)))
    path = next((c for c in candidates if os.path.exists(c)), None)
    if path is None:
        return []
    entries = []
    line = re.compile(r"^([0-9a-fA-F]{8})\s+(\S.*)$")
    for raw in open(path, errors="ignore"):
        found = line.match(raw.strip())
        if found:
            name = found.group(2).strip()
            # a Dolphin layout line - size, virtual address, alignment, name
            layout = re.fullmatch(r"[0-9a-fA-F]{6,8} [0-9a-fA-F]{8}\s+\d+ (\S+)", name)
            entries.append((int(found.group(1), 16), layout.group(1) if layout else name))
    return entries


def main(argv):
    if not argv:
        print(__doc__.strip())
        return 2
    game = os.path.abspath(argv[0])
    src_root = argv[argv.index("--src") + 1] if "--src" in argv else os.path.join(HERE, "..", "src")
    bindings = {}
    bindings_path = os.path.join(game, "bindings.json")
    if os.path.exists(bindings_path):
        with open(bindings_path) as handle:
            bindings = json.load(handle)

    # A game whose symbols are known needs no scan for these: the map names the
    # very functions the natives replace.
    by_name = {}
    for address, name in symbol_map(game):
        by_name.setdefault(canonical(name), address)
        # A map that files an SDK function under its module ("GX::InitTexObj",
        # "VI::GetTvFormat") drops the prefix the native's name keeps
        # (GXInitTexObj): index it under both.
        parts = name.split("::")
        if len(parts) == 2 and parts[0].isupper() and parts[0].isalpha():
            by_name.setdefault(canonical(parts[0] + parts[1]), address)

    natives = library_natives(src_root)
    ids = version_ids(src_root)

    # A native written for one build of a library must not be registered in a
    # game that links another: both variants would claim the same address.
    builds = linked_builds(game)
    gated = [(name, ids.get(version, version)) for name, version in natives]
    inferred, why = inferred_builds(game, bindings, builds, gated)
    if builds is not None:
        builds = builds | set(inferred.values())
    for library, build in sorted(inferred.items()):
        print(f"  {library}: no banner; its code is laid out as {build} ({why[library]})")

    handwritten = already_bound(src_root)

    emitted = []
    withheld = []
    seen = set()
    for index, (name, version) in enumerate(natives):
        if name in handwritten:
            continue
        version_id = ids.get(version, version)
        if builds is not None and not version_id.endswith("@any") and version_id not in builds:
            if bindings.get(name) or bindings.get(f"{name}@{version_id}"):
                withheld.append((name, version_id))
            continue
        # A scan writes an address under the native's own name when it knows the
        # build, and under the registration symbol for the natives that predate
        # this. Either resolves here.
        address = bindings.get(name) or bindings.get(f"{name}@{ids.get(version, version)}")
        if address is None:
            mapped = by_name.get(canonical(name))
            address = f"0x{mapped:08X}" if mapped is not None else None
        if not address:
            continue
        if address in seen:
            continue
        seen.add(address)
        emitted.append((f"wiinx_native_{index}", name, version, address, call_sites(game, int(address, 16)),
                        direct_calls(game, int(address, 16))))

    out_dir = os.path.join(game, "native")
    os.makedirs(out_dir, exist_ok=True)
    out = os.path.join(out_dir, "wiinx_bindings.cpp")
    with open(out, "w") as handle:
        handle.write("// Written by tools/wiinx-emit-bindings. Do not edit: it is\n"
                     "// regenerated from this game's bindings.json every translation.\n"
                     '#include "hle_stubs.h"\n'
                     '#include "abi_bridge.h"\n')
        headers = sorted({version_header(version) for _, _, version, _, _, _ in emitted}
                         | {"wiinx/accel/nw4r.hpp", "wiinx/accel/sdk.hpp"})
        handle.write("".join(f'#include "{h}"\n' for h in headers) + "\n")
        # every function the bindings name, natives or not, by its key and by
        # the names its signatures give it - for natives that call the game
        signatures = json.load(open(os.path.join(HERE, "..", "data", "signatures.json")))["natives"]
        known = public_names(signatures)
        native_names = {name for _, name, *_ in emitted}
        functions = []
        for key, value in sorted(bindings.items()):
            if not isinstance(value, str) or not re.fullmatch(r"0x[0-9A-Fa-f]{8}", value):
                continue
            for spelled in sorted({key} | known.get(key, set())):
                if spelled not in native_names and '"' not in spelled:
                    functions.append((spelled, int(value, 16)))
        handle.write("// what the game's bindings name, for natives that call into it\n"
                     "static const struct { const char* name; wiinx::GuestAddr address; } kBoundFunctions[] = {\n"
                     + "".join(f'    {{"{n}", 0x{a:08X}u}},\n' for n, a in functions)
                     + "};\n"
                     "[[maybe_unused]] static const bool kBoundFunctionsSet = [] {\n"
                     "    for (const auto& f : kBoundFunctions) wiinx::set_bound(f.name, f.address, {});\n"
                     "    return true;\n"
                     "}();\n\n")
        for symbol, name, version, address, calls, direct in emitted:
            listed = ", ".join(f"0x{c:08X}u" for c in calls)
            span = f"{symbol}_calls" if calls else "{}"
            pairs = ", ".join(f"{{0x{t:08X}u, 0x{r:08X}u}}" for t, r in direct)
            direct_span = f"{symbol}_direct" if direct else "{}"
            handle.write(
                f'// {name}\n'
                + (f'static constexpr wiinx::GuestAddr {symbol}_calls[] = {{{listed}}};\n' if calls else '')
                + (f'static constexpr wiinx::DirectCall {symbol}_direct[] = {{{pairs}}};\n' if direct else '')
                + f'[[maybe_unused]] static const bool {symbol}_bound = (wiinx::set_bound("{name}", 0x{int(address, 16):08X}u, {span}, {direct_span}), true);\n'
                f'extern "C" void {symbol}(CpuContext* ctx) {{\n'
                f'    static const wiinx::Native* const native = wiinx::find_native("{name}", {version_expression(version)}.id);\n'
                f'    native->entry(reinterpret_cast<wiinx::Cpu*>(ctx));\n'
                f'}}\n'
                f'PPC_NATIVE_OVERRIDE_VOID({int(address, 16):08X}, {symbol}, (CpuContext* ctx), (ctx));\n\n')
    print(f"wrote {out}: {len(emitted)} of {len(natives)} natives bound in this game")
    # Found in the game but held back: written for a build it does not link (or
    # one nothing proves). Named, never skipped silently.
    bound = {name for _, name, *_ in emitted}
    for name, why in withheld:
        if name not in bound:
            reason = why if ":" in why else f"{why} - the game links another build of it, or none is proven"
            print(f"  withheld: {name} [{reason}]")
    return 0


def version_constants():
    """Each build constant the accel headers declare: its namespace and header.
    EGG's kEgg_Any is wiinx::egg's, in egg.hpp; guessing sdk for everything that
    was not nw4r named a constant that does not exist."""
    found = {}
    accel = os.path.join(HERE, "..", "include", "wiinx", "accel")
    for name in sorted(os.listdir(accel)) if os.path.isdir(accel) else []:
        if not name.endswith(".hpp"):
            continue
        text = open(os.path.join(accel, name), errors="ignore").read()
        namespace = re.search(r"namespace\s+(wiinx::\w+)\s*\{", text)
        if not namespace:
            continue
        for constant in re.findall(r"constexpr\s+LibVersion\s+(k\w+)", text):
            found.setdefault(constant, (namespace.group(1), f"wiinx/accel/{name}"))
    return found


VERSION_CONSTANTS = version_constants()


def version_header(symbol):
    """The accel header that declares a build constant."""
    return VERSION_CONSTANTS.get(symbol, (None, "wiinx/accel/sdk.hpp"))[1]


def version_expression(symbol):
    """How the generated file names a build constant."""
    if symbol in VERSION_CONSTANTS:
        return f"{VERSION_CONSTANTS[symbol][0]}::{symbol}"
    if symbol.startswith("kLyt") or symbol.startswith("kG3d"):
        return f"wiinx::nw4r::{symbol}"
    return f"wiinx::sdk::{symbol}"


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
