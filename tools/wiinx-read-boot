#!/usr/bin/env python3
"""Print what a disc says it is: `<game id> <revision> <region> <title>`.

Reads boot.bin, the first 0x60 bytes of an extracted disc's sys/ folder, so a
project can be made from a disc that is already unpacked.
"""
import sys

if len(sys.argv) != 2:
    raise SystemExit("usage: wiinx-read-boot <disc>/sys/boot.bin")

with open(sys.argv[1], "rb") as boot:
    header = boot.read(0x60)
if len(header) < 0x60:
    raise SystemExit(f"{sys.argv[1]}: not a disc header")

game_id = header[0:6].decode("ascii", "replace").strip("\0")
revision = header[7]
title = header[0x20:0x60].split(b"\0")[0].decode("ascii", "replace").strip()
# The disc ID's fourth character is the region.
regions = {"E": "NTSC-U", "P": "PAL", "J": "NTSC-J", "K": "NTSC-K", "W": "NTSC-T"}
print(game_id, revision, regions.get(game_id[3:4], "unknown"), title)
