#!/usr/bin/env python3
"""Disassemble one function of a game's executable.

    tools/wiinx-disasm <main.dol> <address|name> [--map FILE] [--length N]

For reading a build's code where a native is written: field offsets, vtable
slots, what calls what. The function runs from its start to the next start the
map names (or the scan finds), or for --length bytes. A name is looked up in
the map, mangled or demangled, whole or as a suffix ("Pane::Animate").

The map is the project's functions.map, or any map in the plain `addr name` or
Dolphin `addr size vaddr align name` layout (--map). Calls are annotated with
the name the map gives their target. Needs devkitPPC's powerpc-eabi-objdump,
with Gekko's paired singles decoded (-M 750cl).
"""
import os
import re
import struct
import subprocess
import sys
import tempfile

OBJDUMP = os.path.join(os.environ.get("DEVKITPPC", "/opt/devkitpro/devkitPPC"), "bin", "powerpc-eabi-objdump")


class Dol:
    def __init__(self, path):
        with open(path, "rb") as handle:
            self.data = handle.read()
        if len(self.data) < 0x100:
            raise SystemExit(f"{path}: not a DOL ({len(self.data)} bytes)")
        self.offsets = struct.unpack(">18I", self.data[0x00:0x48])
        self.addresses = struct.unpack(">18I", self.data[0x48:0x90])
        self.sizes = struct.unpack(">18I", self.data[0x90:0xD8])

    def read(self, address, length):
        for i in range(7):
            start, size = self.addresses[i], self.sizes[i]
            if size and start <= address < start + size:
                end = min(address + length, start + size)
                return self.data[self.offsets[i] + address - start:self.offsets[i] + end - start]
        return None


def read_map(path):
    """{address: name} from either map layout"""
    names = {}
    for line in open(path, errors="ignore"):
        parts = line.split()
        if len(parts) >= 5 and re.fullmatch(r"[0-9A-Fa-f]{8}", parts[0]) and re.fullmatch(r"[0-9A-Fa-f]{6,8}", parts[1]):
            names[int(parts[0], 16)] = " ".join(parts[4:])
        elif len(parts) >= 2 and re.fullmatch(r"[0-9A-Fa-f]{8}", parts[0]):
            names[int(parts[0], 16)] = parts[1]
    return names


def find(names, wanted):
    if re.fullmatch(r"(0x)?[0-9A-Fa-f]{8}", wanted):
        return int(wanted, 16)
    exact = [a for a, n in names.items() if n == wanted]
    if exact:
        return exact[0]
    # "Pane::Animate" against "nw4r::lyt::Pane::Animate" or the mangled
    # "Animate__Q34nw4r3lyt4PaneFUl": a suffix of the demangled form, or every
    # part of it in the mangled one
    parts = wanted.split("::")
    hits = [a for a, n in names.items()
            if n.endswith("::" + wanted) or (n.startswith(parts[-1] + "__") and all(p in n for p in parts[:-1]))]
    if len(hits) > 1:
        listed = "\n  ".join(f"{a:08x} {names[a]}" for a in sorted(hits))
        raise SystemExit(f"{wanted}: {len(hits)} functions match, name one by address:\n  {listed}")
    if not hits:
        raise SystemExit(f"{wanted}: not in the map")
    return hits[0]


def main(argv):
    if len(argv) < 2 or argv[0].startswith("-"):
        print(__doc__.strip())
        return 2
    dol = Dol(argv[0])
    map_path = None
    length = None
    if "--map" in argv:
        map_path = argv[argv.index("--map") + 1]
    else:
        guess = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(argv[0]))), "functions.map")
        for candidate in (guess, os.path.join(os.path.dirname(guess), "..", "functions.map")):
            if os.path.exists(candidate):
                map_path = candidate
                break
    if "--length" in argv:
        length = int(argv[argv.index("--length") + 1], 0)
    names = read_map(map_path) if map_path else {}
    start = find(names, argv[1])
    if length is None:
        later = [a for a in names if a > start]
        length = (min(later) - start) if later else 0x400
        length = min(length, 0x4000)
    code = dol.read(start, length)
    if not code:
        raise SystemExit(f"{start:08x}: not in the executable's text")
    with tempfile.NamedTemporaryFile(suffix=".bin") as blob:
        blob.write(code)
        blob.flush()
        out = subprocess.run([OBJDUMP, "-D", "-b", "binary", "-m", "powerpc:750", "-M", "750cl", "-EB",
                              f"--adjust-vma=0x{start:x}", blob.name], capture_output=True, text=True, check=True).stdout
    print(f"{start:08x} {names.get(start, '')}")
    for line in out.splitlines():
        match = re.match(r"\s*([0-9a-f]+):\s+((?:[0-9a-f]{2} ){4})\s*(.*)", line)
        if not match:
            continue
        text = match.group(3)
        target = re.search(r"\b(?:bl|b)\s+0x([0-9a-f]+)", text)
        if target and int(target.group(1), 16) in names:
            text += f"    ; {names[int(target.group(1), 16)]}"
        print(f"  {int(match.group(1), 16):08x}  {text}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
