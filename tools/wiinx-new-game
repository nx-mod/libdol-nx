#!/usr/bin/env bash
# Create a game project from your own disc image, start to finish.
#
#   tools/wiinx-new-game <image> [folder]
#
# <image> is your own dump (.iso, .wbfs, .rvz, .gcz, .ciso), or a disc you
# already extracted, which is linked to rather than copied.
# [folder] is where the project goes; next to this libwii-nx checkout, named
# after the game ID, if left out. It writes:
#
#   <folder>/
#     game.toml     what the game is: ID, region, revision, title
#     recomp.yml    the translator project, filled in from the disc
#     disc/         the extracted disc (never committed)
#     README.md     what to run next
#
# Everything it writes comes from the disc itself: no value is typed by hand.
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
libwiinx=$(cd "$here/.." && pwd)

if [ $# -lt 1 ]; then
    sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'
    exit 2
fi
image=$1
# A disc that is already extracted (its own folder, or a project's disc/) is as
# good a starting point as an image: everything below is read from the disc
# itself either way, and nobody has to rip a disc twice.
extracted=""
for candidate in "$image" "$image/disc"; do
    [ -f "$candidate/sys/boot.bin" ] && { extracted=$candidate; break; }
done

if [ -n "$extracted" ]; then
    extracted=$(cd "$extracted" && pwd)
    read -r game_id revision region title <<<"$(python3 "$here/wiinx-read-boot" "$extracted/sys/boot.bin")"
else
    command -v dolphin-tool >/dev/null || { echo "dolphin-tool not found: install Dolphin" >&2; exit 1; }
    [ -f "$image" ] || { echo "no such image or extracted disc: $image" >&2; exit 1; }

    header=$(dolphin-tool header -i "$image")
    game_id=$(sed -n 's/^Game ID: *//p' <<<"$header" | tr -d '\r')
    revision=$(sed -n 's/^Revision: *//p' <<<"$header" | tr -d '\r')
    region=$(sed -n 's/^Region: *//p' <<<"$header" | tr -d '\r')
    title=$(sed -n 's/^Internal Name: *//p' <<<"$header" | tr -d '\r')
fi
[ -n "$game_id" ] || { echo "could not read a game ID from $image" >&2; exit 1; }

# The disc ID's fourth character is the region: P Europe, E USA, J Japan, K Korea.
region_letter=${game_id:3:1}
name=$(tr 'A-Z' 'a-z' <<<"${game_id:0:4}")-nx
game_dir=${2:-$libwiinx/../$name}
# An existing folder is fine as long as it is not already a game project: a
# game usually gets its own repository, with libwii-nx as a submodule in it,
# and that folder exists before the game does.
for existing in game.toml recomp.yml; do
    [ -e "$game_dir/$existing" ] && {
        echo ">> $game_dir is already a game project ($existing)" >&2; exit 1; }
done
mkdir -p "$game_dir"
game_dir=$(cd "$game_dir" && pwd)
name=$(basename "$game_dir")
# How this game reaches libwii-nx, from where it actually sits.
engine=$(python3 -c "import os,sys; print(os.path.relpath(sys.argv[1], sys.argv[2]))" "$libwiinx" "$game_dir")

echo ">> $title ($game_id, rev $revision, $region) -> $game_dir"
if [ -n "$extracted" ]; then
    if [ "$extracted" != "$game_dir/disc" ]; then
        # Point at the disc where it already is: one copy on disk, and a disc
        # is never committed anyway.
        ln -sfn "$extracted" "$game_dir/disc"
        echo ">> disc: $extracted"
    fi
else
    "$here/wiinx-extract-disc" "$image" "$game_dir"
fi
dol="$game_dir/disc/sys/main.dol"
sha=$(sha256sum "$dol" | cut -d' ' -f1)

cat > "$game_dir/game.toml" <<EOF
# Read from the disc by tools/wiinx-new-game; do not edit by hand.
name = "$name"
title = "$title"
game_id = "$game_id"
revision = $revision
region = "$region"          # $region_letter: the disc ID's fourth character
dol_sha256 = "$sha"
EOF

{
    echo "schema_version: 1"
    echo "workspace_root: ."
    echo
    echo "# $title. Generated by libwii-nx tools/wiinx-new-game from the disc."
    echo "project:"
    echo "  id: ${name%-nx}-$(tr 'A-Z' 'a-z' <<<"$game_id")"
    echo "  display_name: $title"
    echo "  game_id: $game_id            # $region, revision $revision"
    echo "  region: $region_letter"
    echo
    "$here/wiinx-inspect-dol" "$dol" --yaml
    echo
    echo "inputs:"
    echo "  dol:"
    echo "    path: disc/sys/main.dol"
    echo "    sha256: $sha"
    echo
    echo "  # First pass: no unsupported instructions, so gaps surface immediately."
    echo "  # (translation.entry_points above comes from the DOL header.)"
    echo
    echo "# Where libwii-nx is, relative to this folder: the natives translated"
    echo "# calls bind to. Change these two if you move either checkout."
    echo "runtime:"
    echo "  native_registration_root: $engine/src"
    echo "  native_abi_directories:"
    echo "    - $engine/src/platform/gx"
    echo "  # Written by wiinx-scan: which address each native has in this game."
    echo "  native_bindings: bindings.json"
    echo
    echo "output:"
    echo "  root: generated"
    echo "  functions: functions"
    echo "  runtime_config: RuntimeConfig.h"
    echo "  data_initializer: data_sections_init.cpp"
    echo "  base_manifest: build/base/${name%-nx}_base_manifest.json"
} > "$game_dir/recomp.yml"

cat > "$game_dir/.gitignore" <<'EOF'
# Game code and data are never committed: build from your own disc.
# No trailing slash on disc: it is often a link to where the disc already is.
/disc
/generated/
/build/
/functions.map
EOF

cat > "$game_dir/README.md" <<EOF
# $name

$title ($game_id, revision $revision, $region), running natively on Switch with
[libwii-nx](https://github.com/nx-mod/libwii-nx).

Created by \`wiinx-new-game\` from a disc dump. The disc itself is never in this
repository: you supply your own.

## Status

Fresh project: translated code not built yet.

## Build it from your own disc

\`\`\`sh
$engine/tools/wiinx-scan scan disc/sys/main.dol --out bindings.json   # where its natives are
$engine/tools/wiinx-translate .                                       # DOL -> C++
\`\`\`

## What came from the disc

| | |
|---|---|
| Game ID | \`$game_id\` |
| Revision | $revision |
| Region | $region ($region_letter) |
| main.dol SHA-256 | \`$sha\` |

\`recomp.yml\` holds the entry point and small-data bases read from \`main.dol\`;
\`$engine/tools/wiinx-inspect-dol disc/sys/main.dol\` prints them again at any time.
EOF

echo ">> wrote $game_dir/{game.toml,recomp.yml,README.md,.gitignore}"
echo ">> next: $engine/tools/wiinx-translate $game_dir"
