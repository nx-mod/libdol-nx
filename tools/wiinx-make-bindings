#!/usr/bin/env python3
"""Turn a game's resolved addresses into the table its build links.

    tools/wiinx-make-bindings <resolved.json> <native_bindings.cpp> [--report]
    tools/wiinx-make-bindings --identity <native_bindings.cpp>

`resolved.json` is a game's bindings.json, as `wiinx-scan` writes it: the
runtime's native replacements by name, each with the address it lives at *in
that game*.

The table the runtime links is keyed by reference address instead - the address
each registration was written from, which data/reference-bindings.json records.
One native often replaces several guest functions, so a name can stand for more
than one registration, and only the address tells them apart.

--identity writes the table for the game the registrations were written from,
where every function is already at its reference address. That game then
carries a table like any other, and nothing in the build treats it specially.

Anything not placed is simply absent, and the runtime runs that game's own code
instead of a replacement pointed at the wrong address. --report lists what is
missing, which is the work left for a game.
"""

import json
import os
import re
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
REFERENCE = os.path.join(os.path.dirname(HERE), "data", "reference-bindings.json")


def reference_table():
    """{reference address: native symbol}, the master table."""
    if not os.path.exists(REFERENCE):
        sys.exit(f"{REFERENCE} is missing: run tools/wiinx-reference-bindings")
    return {int(key, 16): entry["native"]
            for key, entry in json.load(open(REFERENCE)).items()}


OVERRIDE = re.compile(
    r"PPC_NATIVE_OVERRIDE[A-Z_]*\(\s*([0-9A-Fa-f]{8})")
REGISTER = re.compile(
    r"REGISTER_NATIVE_FUNCTION\(\s*0x([0-9A-Fa-f]{8})")


def game_own(output_path):
    """A game's own replacements, which are written at its own addresses.

    Everything in the libraries is SDK code that every game carries somewhere
    else, so it is matched by signature and moved. A native written for one
    game, in that game's folder, already names where the function is: it binds
    to itself, and appears in the table so that it binds at all.
    """
    directory = os.path.dirname(os.path.abspath(output_path))
    if not os.path.isdir(directory):
        return set()
    found = set()
    for name in sorted(os.listdir(directory)):
        path = os.path.join(directory, name)
        if not name.endswith(".cpp") or os.path.abspath(path) == os.path.abspath(output_path):
            continue
        text = open(path, errors="ignore").read()
        for pattern in (OVERRIDE, REGISTER):
            found |= {int(address, 16) for address in pattern.findall(text)}
    return found


def write(output_path, entries, source):
    """entries: sorted [(reference, address)]."""
    with open(output_path, "w") as out:
        out.write(f"""// Where this game keeps the functions the runtime replaces.
//
// Generated by libdol-nx tools/wiinx-make-bindings from
// {source}; do not edit.
//
// Each entry is the address a registration was written from and the address
// that same function has in this game. A registration absent from this table
// was not placed, so it is not registered and the game's own code runs.
#include "native_bindings.h"

namespace NativeBindings {{
namespace {{

// Sorted by reference address: the runtime binary-searches this at startup.
constexpr Binding kBindings[] = {{
""")
        for reference, address in entries:
            out.write(f"    {{0x{reference:08X}u, 0x{address:08X}u}},\n")
        out.write(f"""}};

}}  // namespace

const Binding* Table() noexcept {{ return kBindings; }}

std::size_t TableSize() noexcept {{ return {len(entries)}; }}

}}  // namespace NativeBindings
""")
    print(f"{len(entries)} bindings -> {output_path}")


def main(argv):
    paths = [value for value in argv if not value.startswith("-")]
    natives = reference_table()

    if "--identity" in argv:
        if len(paths) != 1:
            print(__doc__)
            return 2
        write(paths[0], sorted((address, address) for address in natives),
              "data/reference-bindings.json (this game is the one they were written from)")
        return 0

    if len(paths) != 2:
        print(__doc__)
        return 2
    resolved_path, output_path = paths
    resolved = json.load(open(resolved_path))

    # Two shapes are accepted. wiinx-scan writes names, because a name is what
    # it matched. A game whose functions are already at the reference addresses
    # - the one the registrations were read from - writes those addresses
    # instead, which says exactly the same thing without a name to be ambiguous
    # about. Neither is a mode: it is what the file says.
    if resolved and all(key.lower().startswith("0x") for key in resolved):
        entries = {int(key, 16): int(value, 16) for key, value in resolved.items()}
        entries.update({address: address for address in game_own(output_path)})
        write(output_path, sorted(entries.items()), os.path.basename(resolved_path))
        return 0

    # A name can stand for more than one registration. Where it does, nothing
    # says which of them this game's address belongs to, so none are bound and
    # the game's own code runs - the same answer as a name we never placed.
    references = {}
    for reference, native in natives.items():
        references.setdefault(native, []).append(reference)

    entries, ambiguous, unknown = [], [], []
    for name, address in resolved.items():
        found = references.get(name)
        if not found:
            unknown.append(name)
        elif len(found) > 1:
            ambiguous.append(f"{name} ({len(found)} registrations)")
        else:
            entries.append((found[0], int(address, 16)))

    placed = dict(entries)
    placed.update({address: address for address in game_own(output_path)})
    write(output_path, sorted(placed.items()), os.path.basename(resolved_path))

    if ambiguous:
        print(f"not bound, one name for several registrations: {', '.join(sorted(ambiguous))}")
    if unknown:
        print(f"not bound, no registration of that name: {', '.join(sorted(unknown))}")
    if "--report" in argv:
        placed = {reference for reference, _ in entries}
        missing = sorted(natives[r] for r in natives if r not in placed)
        print(f"\n{len(missing)} of {len(natives)} registrations are not placed in this game,")
        print("so its own code runs for them. Each is a candidate for hand work:")
        for native in missing:
            print(f"  {native}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
