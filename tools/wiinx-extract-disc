#!/usr/bin/env bash
# Extract a disc image into a game's disc/ folder.
#
#   tools/wiinx-extract-disc <image> <game-folder>
#
# <image> is your own dump: .iso, .gcm, .wbfs, .ciso, .rvz or .wia.
# <game-folder> is the project folder; the disc lands in <game-folder>/disc/
# as files/ and sys/, with sys/main.dol the code the translator reads.
#
# Uses this library's own reader (tools/src/wiinx_disc.cpp), so nothing else has
# to be installed. If that has not been built, it falls back to Dolphin's
# dolphin-tool, which handles the same formats and a few more.
set -euo pipefail

if [ $# -lt 2 ]; then
    sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
    exit 2
fi

image=$1
game_dir=$2
disc_dir="$game_dir/disc"
here=$(cd "$(dirname "$0")" && pwd)

[ -f "$image" ] || { echo "no such image: $image" >&2; exit 1; }

# The reader, wherever this checkout built it.
reader=""
for candidate in "$here/../build/wiinx-disc" "$here/../build-host/wiinx-disc" \
                 "$(command -v wiinx-disc || true)"; do
    if [ -n "$candidate" ] && [ -x "$candidate" ]; then
        reader=$candidate
        break
    fi
done

mkdir -p "$disc_dir"

if [ -n "$reader" ]; then
    echo ">> $image"
    "$reader" extract "$image" "$disc_dir"
    exit 0
fi

echo "wiinx-disc is not built; falling back to dolphin-tool." >&2
echo "  cmake -S . -B build && cmake --build build --target wiinx-disc" >&2

command -v dolphin-tool >/dev/null || {
    echo "dolphin-tool not found either: install Dolphin (dolphin-emu-tools)" >&2
    exit 1
}

echo ">> $image"
dolphin-tool extract -i "$image" -o "$disc_dir"
