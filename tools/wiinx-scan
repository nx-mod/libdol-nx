#!/usr/bin/env python3
"""Find which library builds a game links, and where its natives' functions are.

    tools/wiinx-scan builds <game.dol>
    tools/wiinx-scan scan   <game.dol> [--out bindings.json]
    tools/wiinx-scan functions <game.dol> [--out functions.map]
    tools/wiinx-scan os-globals <game.dol>
    tools/wiinx-scan sign   <game.dol> <name> <build> <address> <size>
    tools/wiinx-scan sign-asm <game.dol> <name> <registration> <address> <size>
    tools/wiinx-scan record <game id> <game.dol>...
    tools/wiinx-scan header

builds  lists the library builds the game names in its startup banners, as
        build ids: "<< NW4R - LYT final build: Mar 8 2008 ... >>" is
        nw4r.lyt@2008-03-08.
scan    finds each native's function in the game - for the builds it links -
        by code signature, and prints what it found. --out writes the game's
        bindings.json: each native's registration name against the address it
        has in this game, which is what the translator reads.
functions
        finds where this game's functions start, from its own code: every
        direct call's target, and every pointer into the code that follows a
        return (vtables, jump tables). --out writes the translator's function
        map, which is how a game without a symbol map gets translated whole
        instead of only as far as direct calls reach.
os-globals
        finds where this game's copy of the Wii's OS keeps the scheduler's
        globals, from the shape of SelectThread, and prints the layout the
        game installs (see libwii-nx docs/game-hooks.md).
sign    records a function's signature from a game you have, for adding a
        native. Run it on your own disc's DOL; it prints the entry for
        data/signatures.json.
sign-asm
        the same, for a part of the SDK that is hand-written assembly: the
        instructions are identical in every build, so it is signed against no
        build ("any") and matched whole rather than by a masked window. Use it
        only where the code really is build-independent - check it against a
        second game before adding it.
record  adds the builds a game's executables name to data/builds.json, with
        the game ID as where each was seen.
header  writes include/wiinx/builds.hpp from data/builds.json: every known
        build as a LibVersion constant.

A signature holds hashes, never code: the first 16 instructions and the whole
function, each with the operands that legitimately differ between games masked
out (branch targets, lis/addis immediates, small-data offsets). A function
matches when both hashes do and the match is unique in the game.
"""

import datetime
import hashlib
import json
import os
import re
import struct
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
SIGNATURES = os.path.join(HERE, "..", "data", "signatures.json")
ANY_BUILD = "any"
WINDOW = 16  # instructions in the start window


class Dol:
    def __init__(self, path):
        with open(path, "rb") as handle:
            self.data = handle.read()
        if len(self.data) < 0x100:
            raise SystemExit(f"{path}: not a DOL ({len(self.data)} bytes)")
        self.offsets = struct.unpack(">18I", self.data[0x00:0x48])
        self.addresses = struct.unpack(">18I", self.data[0x48:0x90])
        self.sizes = struct.unpack(">18I", self.data[0x90:0xD8])

    def text(self):
        for i in range(7):
            if self.sizes[i]:
                yield self.addresses[i], self.data[self.offsets[i]:self.offsets[i] + self.sizes[i]]

    def read(self, address, length):
        for start, blob in self.text():
            if start <= address and address + length <= start + len(blob):
                return blob[address - start:address - start + length]
        return None


def function_starts(dol):
    """Every address in the DOL that a function plausibly starts at.

    Recursive descent alone sees only what the entry point can reach by direct
    calls, which in a C++ game is a small part of it: everything behind a
    virtual call is invisible. Two sources between them find the rest:

      * the target of every `bl` in the code - certain, and most of them;
      * every word anywhere in the image that points at a place in the code
        which follows a return - vtables and function pointer tables;
      * every stack frame a function opens for itself (`stwu r1,-N(r1)`, on its
        own or after `mflr r0`), which is how the compiler starts one.

    The last two are guesses, so the translator seeds map entries
    speculatively: one that turns out not to be code is dropped with a count,
    not an error. Measured against Mario Kart Wii's symbol map, the three
    together find 91.8% of its real function starts, and 2.8% of what they find
    is not in that map.
    """
    text = list(dol.text())
    starts = set()

    def in_text(address):
        return any(start <= address < start + len(blob) for start, blob in text)

    def word_at(address):
        raw = dol.read(address, 4)
        return struct.unpack(">I", raw)[0] if raw else None

    for start, blob in text:
        for offset in range(0, len(blob) & ~3, 4):
            word = struct.unpack(">I", blob[offset:offset + 4])[0]
            if word >> 26 != 18 or not (word & 1):  # bl, and not blrl
                continue
            displacement = word & 0x03FFFFFC
            if displacement & 0x02000000:
                displacement -= 0x04000000
            target = displacement if word & 2 else (start + offset + displacement) & 0xFFFFFFFF
            if in_text(target):
                starts.add(target)

    # A function that opens a stack frame says where it starts: CodeWarrior
    # emits `stwu r1,-N(r1)` first, or `mflr r0` and then the `stwu`.
    for start, blob in text:
        for offset in range(0, len(blob) & ~3, 4):
            word = struct.unpack(">I", blob[offset:offset + 4])[0]
            if (word & 0xFFFF0000) == 0x94210000 and word & 0x8000:
                starts.add(start + offset)
            elif word == 0x7C0802A6:  # mflr r0
                following = word_at(start + offset + 4)
                if following is not None and (following & 0xFFFF0000) == 0x94210000:
                    starts.add(start + offset)

    # A function that only a pointer table names still follows something that
    # ended: a return, an unconditional branch, or the padding between them.
    terminators = {0x4E800020, 0x4E800420, 0x4C000064, 0x00000000, 0x60000000}
    for i in range(18):
        if not dol.sizes[i]:
            continue
        blob = dol.data[dol.offsets[i]:dol.offsets[i] + dol.sizes[i]]
        for offset in range(0, len(blob) & ~3, 4):
            candidate = struct.unpack(">I", blob[offset:offset + 4])[0]
            if candidate & 3 or not in_text(candidate) or candidate in starts:
                continue
            previous = word_at(candidate - 4)
            if previous is None or previous in terminators or previous >> 26 == 18:
                starts.add(candidate)

    return sorted(starts)


def _sda_base(dol):
    """_SDA_BASE_ (r13) from the startup code: lis r13 / addi r13 near the entry."""
    entry = struct.unpack(">I", dol.data[0xE0:0xE4])[0]
    address = entry
    for _ in range(4096):
        raw = dol.read(address, 8)
        if raw is None:
            return None
        instruction, following = struct.unpack(">II", raw)
        if instruction >> 26 == 15 and (instruction >> 16) & 31 == 0 and (instruction >> 21) & 31 == 13:
            if following >> 26 in (14, 24) and (following >> 21) & 31 == 13:
                low = following & 0xFFFF
                if following >> 26 == 14 and low >= 0x8000:
                    low -= 0x10000
                return (((instruction & 0xFFFF) << 16) + low) & 0xFFFFFFFF
        address += 4
    return None


def os_globals(dol):
    """Where this game's copy of the Wii's OS keeps the scheduler's globals.

    Found from the shape of SelectThread, which every RVL OS build has and no
    other code looks like: it reads the mask of non-empty run queues from a
    small-data global, counts its leading zeros to get the highest priority
    waiting, and indexes the run queue array by that priority times eight.

      lwz   rX, -d(r13)     <- RunQueueBits
      cntlzw rX, rX
      lis   rY, hi          <- RunQueue, built a few instructions later
      addi  rY, rY, lo         (the compiler puts other work between them)
      rlwinm rZ, rZ, 3

    The three words the scheduler keeps together - how deep
    OSDisableScheduler is nested, whether a switch is owed, and that mask -
    are declared in that order in one file, so the other two sit just below
    the mask; both are confirmed by finding code that touches them.
    """
    sda = _sda_base(dol)
    if sda is None:
        return None

    text = list(dol.text())

    def word_at(address):
        raw = dol.read(address, 4)
        return struct.unpack(">I", raw)[0] if raw else None

    def signed(value):
        return value - 0x10000 if value & 0x8000 else value

    def sda_offsets_touched():
        """Every r13-relative load/store offset the game's code uses."""
        offsets = set()
        for _, blob in text:
            for position in range(0, len(blob) & ~3, 4):
                instruction = struct.unpack(">I", blob[position:position + 4])[0]
                if instruction >> 26 in (32, 36) and (instruction >> 16) & 31 == 13:
                    offsets.add(signed(instruction & 0xFFFF))
        return offsets

    candidates = {}
    for start, blob in text:
        for position in range(0, len(blob) & ~3, 4):
            instruction = struct.unpack(">I", blob[position:position + 4])[0]
            if instruction >> 26 != 31 or (instruction >> 1) & 0x3FF != 26:
                continue  # cntlzw
            address = start + position
            source = (instruction >> 21) & 31

            bits = None
            for back in range(4, 40, 4):
                previous = word_at(address - back)
                if previous is None:
                    continue
                if (previous >> 26 == 32 and (previous >> 16) & 31 == 13
                        and (previous >> 21) & 31 == source):
                    bits = (sda + signed(previous & 0xFFFF)) & 0xFFFFFFFF
                    break
            if bits is None:
                continue

            # The base is a lis and an addi to the same register, which the
            # compiler is free to separate.
            queue = None
            scaled = False
            for forward in range(4, 80, 4):
                following = word_at(address + forward)
                if following is None:
                    continue
                if following >> 26 == 21 and (following >> 11) & 31 == 3:
                    scaled = True  # the priority scaled to the queue's stride
                if queue is None and following >> 26 == 15 and (following >> 16) & 31 == 0:
                    register = (following >> 21) & 31
                    high = (following & 0xFFFF) << 16
                    for tail in range(4, 32, 4):
                        low_instruction = word_at(address + forward + tail)
                        if low_instruction is None:
                            continue
                        if (low_instruction >> 26 in (14, 24)
                                and (low_instruction >> 21) & 31 == register
                                and (low_instruction >> 16) & 31 == register):
                            low = low_instruction & 0xFFFF
                            queue = ((high + signed(low)) if low_instruction >> 26 == 14
                                     else (high | low)) & 0xFFFFFFFF
                            break
            if queue is not None and scaled:
                candidates.setdefault((bits, queue), []).append(address)

    if not candidates:
        return None
    (bits, queue), sites = max(candidates.items(), key=lambda item: len(item[1]))

    touched = sda_offsets_touched()
    def below(distance):
        address = (bits - distance) & 0xFFFFFFFF
        return address if signed((address - sda) & 0xFFFF) in touched else 0

    materialised = addresses_materialised(text)

    # OSThread.c declares DefaultThread, then RunQueue[32], then IdleThread, and
    # the linker keeps that order: the thread the game booted on ends where the
    # queues begin, and the idle thread starts where they end. Each is reported
    # only when the game's code builds that address somewhere.
    def neighbour(distance):
        address = (queue + distance) & 0xFFFFFFFF
        return address if address in materialised else 0

    return {
        "run_queue": queue,
        "run_queue_bits": bits,
        "reschedule": below(4),
        "scheduler_disable_count": below(8),
        "default_thread": neighbour(-0x318),   # sizeof(OSThread)
        "idle_thread": neighbour(0x100),       # 32 queues, head and tail each
        "sda_base": sda,
        "found_at": sites,
    }


def addresses_materialised(text):
    """Every address the code builds with a lis and an addi or ori."""
    built = set()
    pending = {}
    for start, blob in text:
        pending.clear()
        for position in range(0, len(blob) & ~3, 4):
            instruction = struct.unpack(">I", blob[position:position + 4])[0]
            opcode = instruction >> 26
            target = (instruction >> 21) & 31
            if opcode == 15 and (instruction >> 16) & 31 == 0:
                pending[target] = (instruction & 0xFFFF) << 16
            elif opcode in (14, 24) and (instruction >> 16) & 31 == target and target in pending:
                low = instruction & 0xFFFF
                if opcode == 14:
                    built.add((pending[target] + (low - 0x10000 if low & 0x8000 else low)) & 0xFFFFFFFF)
                else:
                    built.add(pending[target] | low)
                del pending[target]
            elif target in pending and opcode in (15, 32, 36, 14, 24):
                # The register was reused for something else.
                del pending[target]
    return built


def mask(word):
    """Zero the operand bits that differ between two games' copies of a function."""
    opcode = word >> 26
    if opcode == 18:                      # b / bl: target
        return word & 0xFC000003
    if opcode == 16:                      # bc: target
        return word & 0xFFFF0003
    if opcode in (15, 3):                 # lis/addis, twi: immediate
        return word & 0xFFFF0000
    if 32 <= opcode <= 55 or opcode in (14, 24, 25, 28, 29):
        if ((word >> 16) & 31) in (2, 13):  # relative to the small-data registers
            return word & 0xFFFF0000
    return word


def masked_hash(code):
    """Hash a function with everything that legitimately moves blanked out.

    mask() handles what one instruction can decide on its own. The rest needs
    the stream: an address of a global is built from a `lis` and an `addi` (or
    `ori`, or the displacement of the load that uses it), and only the `lis`
    half looks like an immediate. The `addi` that completes the pair carries
    the low half of an address that is different in every build, so it is
    blanked too - tracked per register, and forgotten as soon as the register
    is written by anything else.
    """
    words = struct.unpack(f">{len(code) // 4}I", code[: len(code) // 4 * 4])
    masked = []
    pending = set()
    for word in words:
        opcode = word >> 26
        target = (word >> 21) & 31
        base = (word >> 16) & 31
        value = mask(word)
        if opcode == 15 and base == 0:                       # lis rD, hi
            pending.add(target)
        elif base in pending and (32 <= opcode <= 55 or opcode in (14, 24, 25, 28, 29)):
            # The low half of the same address: addi/ori, or a load or store
            # reaching through the register the lis set up.
            value = word & 0xFFFF0000
            if opcode in (14, 24) and target != base:
                pending.add(target)                          # the address moved registers
            elif opcode in (14, 24):
                pending.discard(base)                        # completed in place
        elif target in pending and opcode != 15:
            pending.discard(target)                          # register reused for something else
        masked.append(value)
    return hashlib.sha256(struct.pack(f">{len(masked)}I", *masked)).hexdigest()[:16]


MONTHS = {m: i + 1 for i, m in enumerate("Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec".split())}
BANNER = re.compile(rb"<< (NW4R|RVL_SDK|EGG) +- +([A-Z0-9_]+) \t?[a-z]+ +build: "
                    rb"([A-Z][a-z]{2}) +(\d{1,2}) (\d{4}) [\d:]+ \((0x[0-9a-f_]+)\)( UNOFFICIAL)? >>")


def builds(dol):
    """{lib: (build id, banner)} for every library banner in the game."""
    found = {}
    for m in BANNER.finditer(dol.data):
        family, lib, month, day, year, code, unofficial = (g.decode() if g else "" for g in m.groups())
        if unofficial:
            continue
        name = f"{'rvl' if family == 'RVL_SDK' else family.lower()}.{lib.lower()}"
        date = datetime.date(int(year), MONTHS[month], int(day)).isoformat()
        found[name] = (f"{name}@{date}", f"{family} - {lib} {month} {int(day):>2} {year} ({code})")
    return found


BUILDS = os.path.join(HERE, "..", "data", "builds.json")
HEADER = os.path.join(HERE, "..", "include", "wiinx", "builds.hpp")


def load_builds():
    if not os.path.exists(BUILDS):
        return {}
    with open(BUILDS) as handle:
        return {b["id"]: b for b in json.load(handle)["builds"]}


def save_builds(known):
    with open(BUILDS, "w") as handle:
        json.dump({"about": "Every library build seen in a game's startup banners. "
                            "Add games with tools/wiinx-scan record; regenerate the "
                            "header with tools/wiinx-scan header.",
                   "builds": sorted(known.values(), key=lambda b: b["id"])}, handle, indent=1)
        handle.write("\n")


def constant_name(build_id):
    lib, date = build_id.split("@")
    family, name = lib.split(".", 1)
    return f"k{family.capitalize()}{name.capitalize()}_{date.replace('-', '_')}"


def write_header(known):
    lines = [
        "// Every library build libwii-nx knows, as games name them in their startup",
        "// banners. Generated by tools/wiinx-scan header from data/builds.json - do",
        "// not edit by hand.",
        "#pragma once",
        "",
        '#include "wiinx/core/native.hpp"',
        "",
        "namespace wiinx::builds {",
        "",
    ]
    family = None
    for build in sorted(known.values(), key=lambda b: b["id"]):
        lib = build["id"].split("@")[0]
        if lib != family:
            if family is not None:
                lines.append("")
            family = lib
        seen = ", ".join(build["seen_in"])
        lines.append(f'inline constexpr LibVersion {constant_name(build["id"])}'
                     f'{{"{build["id"]}", "{lib}", "{build["banner"].split(" ", 3)[-1]}"}};  // {seen}')
    lines += ["", "}  // namespace wiinx::builds", ""]
    with open(HEADER, "w") as handle:
        handle.write("\n".join(lines))


def load_signatures():
    with open(SIGNATURES) as handle:
        return json.load(handle)["natives"]


def exact_hash(code):
    """A hash of instructions exactly as they are, masking nothing."""
    return hashlib.sha256(code).hexdigest()[:16]


def find_exact(dol, signatures):
    """Match the signatures that are the same code in every game.

    Parts of the SDK are hand-written assembly - the cache range operations,
    masking interrupts, reading the clock - and the assembler emits the same
    instructions for every build of it. They are too short to sign the usual
    way (the window is 16 instructions and these are five), and they have no
    relocated operands to mask, so they are matched whole: hash every aligned
    run of the right length and keep the one that matches.
    """
    hits = {signature["exact"]: [] for signature in signatures}
    for size in {signature["size"] for signature in signatures}:
        wanted = {s["exact"] for s in signatures if s["size"] == size}
        for start, blob in dol.text():
            for offset in range(0, len(blob) - size + 1, 4):
                key = exact_hash(blob[offset:offset + size])
                if key in wanted:
                    hits[key].append(start + offset)
    return hits


def scan(dol):
    linked = {build_id for build_id, _ in builds(dol).values()}
    signatures = load_signatures()
    # A signature for a build this game does not link cannot be its code, but
    # one written for no build in particular (hand-written assembly, the same
    # everywhere) applies to every game.
    candidates = [s for s in signatures
                  if s["build"] == ANY_BUILD or s["build"] in linked]
    exact = [s for s in candidates if "exact" in s]
    masked = [s for s in candidates if "exact" not in s]

    # Index the game's start windows once: every aligned address in its text.
    by_window = {}
    for start, blob in dol.text():
        for offset in range(0, len(blob) - WINDOW * 4 + 1, 4):
            key = masked_hash(blob[offset:offset + WINDOW * 4])
            by_window.setdefault(key, []).append(start + offset)

    bindings, missing = [], []
    for sig in masked:
        hits = [a for a in by_window.get(sig["start"], [])
                if (code := dol.read(a, sig["size"])) is not None and masked_hash(code) == sig["body"]]
        if len(hits) == 1:
            bindings.append({"name": sig["name"], "build": sig["build"], "address": f"0x{hits[0]:08X}",
                             "registration": sig.get("registration")})
        else:
            missing.append((sig["name"], sig["build"], len(hits)))

    if exact:
        found = find_exact(dol, exact)
        for sig in exact:
            hits = found[sig["exact"]]
            if len(hits) == 1:
                bindings.append({"name": sig["name"], "build": sig["build"],
                                 "address": f"0x{hits[0]:08X}",
                                 "registration": sig.get("registration")})
            else:
                missing.append((sig["name"], sig["build"], len(hits)))
    return bindings, missing


def main(argv):
    if not argv:
        print(__doc__.strip())
        return 2
    command = argv[0]
    if command in ("record", "header"):
        return commands_without_dol(argv)
    if len(argv) < 2:
        print(__doc__.strip())
        return 2
    dol = Dol(argv[1])
    if command == "builds":
        for lib, (build_id, banner) in sorted(builds(dol).items()):
            print(f"{build_id:<24} {banner}")
        return 0
    if command == "os-globals":
        found = os_globals(dol)
        if not found:
            print("no OS scheduler globals found: this game's SelectThread was not recognised")
            return 1
        print(f"# from {argv[1]}, found at " +
              ", ".join(f"0x{site:08X}" for site in found["found_at"][:3]))
        print("RuntimeGuestOs::Layout layout;")
        for field in ("run_queue", "run_queue_bits", "reschedule", "scheduler_disable_count",
                      "default_thread", "idle_thread"):
            value = found[field]
            print(f"layout.{field} = 0x{value:08X}u;" if value
                  else f"// layout.{field} = ?;  not confirmed")
        return 0
    if command == "sign-asm" and len(argv) >= 6:
        # Hand-written SDK assembly: the same instructions in every game, so it
        # is signed against no build and matched whole.
        name, registration = argv[2], argv[3]
        address, size = int(argv[4], 16), int(argv[5], 16) if argv[5].startswith("0x") else int(argv[5])
        code = dol.read(address, size)
        if code is None:
            print(f"0x{address:08X}+{size} is not in this game's code")
            return 1
        entry = {
            "name": name,
            "build": ANY_BUILD,
            "size": size,
            "exact": exact_hash(code),
            "signed_from": os.path.basename(argv[1]),
            "registration": registration,
        }
        hits = find_exact(dol, [entry])[entry["exact"]]
        if len(hits) != 1:
            print(f"# not unique in this game ({len(hits)} matches): "
                  + ", ".join(f"0x{hit:08X}" for hit in hits))
            return 1
        print(json.dumps(entry, indent=1))
        return 0
    if command == "functions":
        starts = function_starts(dol)
        if "--out" in argv:
            path = argv[argv.index("--out") + 1]
            with open(path, "w") as handle:
                # The translator's map format: one "hexaddr name" line each,
                # the address repeated where no name is known - and none is:
                # these come from the code, not from a symbol table.
                for address in starts:
                    handle.write(f"{address:08x} {address:08x}\n")
            print(f"wrote {path}: {len(starts)} function starts")
        else:
            for address in starts:
                print(f"{address:08x}")
        return 0
    if command == "scan":
        bindings, missing = scan(dol)
        for b in bindings:
            print(f"{b['address']}  {b['name']}  [{b['build']}]")
        for name, build_id, hits in missing:
            print(f"not found  {name}  [{build_id}]  ({hits} matches)")
        if "--out" in argv:
            path = argv[argv.index("--out") + 1]
            # The translator's format: registration name -> address, nothing else.
            table = {b["registration"]: b["address"] for b in bindings if b.get("registration")}
            with open(path, "w") as handle:
                json.dump(dict(sorted(table.items())), handle, indent=1)
                handle.write("\n")
            print(f"wrote {path}: {len(table)} bindings")
        return 0 if not missing else 1
    print(__doc__.strip())
    return 2


def commands_without_dol(argv):
    command = argv[0]
    if command == "record" and len(argv) >= 3:
        game_id, known = argv[1], load_builds()
        added = 0
        for path in argv[2:]:
            for lib, (build_id, banner) in builds(Dol(path)).items():
                entry = known.setdefault(build_id, {"id": build_id, "banner": banner, "seen_in": []})
                if game_id not in entry["seen_in"]:
                    entry["seen_in"].append(game_id)
                    entry["seen_in"].sort()
                    added += 1
        save_builds(known)
        print(f"{game_id}: {added} build sightings recorded; {len(known)} builds known")
        return 0
    if command == "header":
        known = load_builds()
        write_header(known)
        print(f"wrote {HEADER}: {len(known)} builds")
        return 0
    if command == "sign" and len(argv) == 6:
        name, build_id, address, size = argv[2], argv[3], int(argv[4], 16), int(argv[5], 16)
        code = dol.read(address, size)
        if code is None or size < WINDOW * 4:
            print("no function of that size there (functions shorter than 16 instructions are not signed)")
            return 1
        entry = {"name": name, "build": build_id, "size": size,
                 "start": masked_hash(code[:WINDOW * 4]), "body": masked_hash(code)}
        print(json.dumps(entry))
        return 0
    print(__doc__.strip())
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
