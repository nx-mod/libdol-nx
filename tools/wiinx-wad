#!/usr/bin/env python3
"""Look inside a WAD, or unpack one.

    tools/wiinx-wad <file.wad>                  what is in it
    tools/wiinx-wad <file.wad> <output-folder>  unpack it, decrypted

A WAD is a title packed as one file: the certificates that signed it, the
ticket, the TMD, and then every content the TMD lists. Channels, WiiWare and
Virtual Console games all travel this way, and so does boot2 - the two kinds are
told apart by a tag in the header, "Is" for an installable title and "ib" for a
boot image.

Unpacking decrypts each content with the title's own key and writes the one that
looks like an executable as main.dol, which is what the rest of the toolkit
expects from a disc as well. Nothing Nintendo owns ends up in this repository:
the output folder is yours and is not tracked.
"""

import os
import struct
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from wiicrypto import COMMON_KEY, aes_cbc_decrypt  # noqa: E402
from wiinand import looks_like_dol, dol_score  # noqa: E402

SIGNATURE = 0x140          # an RSA-2048 signature and its padding
ALIGN = 0x40

KINDS = {0x4973: "installable title", 0x6962: "boot2 image"}

# What the high word of a title id says the title is.
TITLE_KINDS = {
    0x00000001: "system title",
    0x00010000: "disc save",
    0x00010001: "channel or WiiWare",
    0x00010002: "system channel",
    0x00010004: "game channel",
    0x00010005: "downloadable content",
    0x00010008: "hidden channel",
}


def align(value):
    return (value + ALIGN - 1) & ~(ALIGN - 1)


def expand(data):
    """Nintendo's own compression, undone: LZ77 (0x10) and LZ11 (0x11).

    A WiiWare title keeps its code compressed and expands it while loading, so
    a content that looks like nothing is often a compressed executable.
    """
    if len(data) < 8 or data[0] not in (0x10, 0x11):
        return None
    lz11 = data[0] == 0x11
    size = int.from_bytes(data[1:4], "little")
    at = 4
    if size == 0:
        size = int.from_bytes(data[4:8], "little")
        at = 8

    out = bytearray()
    flags = 0
    left = 0
    while len(out) < size and at < len(data):
        if left == 0:
            flags, at, left = data[at], at + 1, 8
        reference, flags, left = flags & 0x80, (flags << 1) & 0xFF, left - 1

        if not reference:
            out.append(data[at])
            at += 1
            continue

        first = data[at]
        if not lz11:
            length, distance = (first >> 4) + 3, ((first & 0xF) << 8 | data[at + 1]) + 1
            at += 2
        elif first >> 4 == 0:
            length = (first << 4 | data[at + 1] >> 4) + 0x11
            distance = ((data[at + 1] & 0xF) << 8 | data[at + 2]) + 1
            at += 3
        elif first >> 4 == 1:
            length = ((first & 0xF) << 12 | data[at + 1] << 4 | data[at + 2] >> 4) + 0x111
            distance = ((data[at + 2] & 0xF) << 8 | data[at + 3]) + 1
            at += 4
        else:
            length, distance = (first >> 4) + 1, ((first & 0xF) << 8 | data[at + 1]) + 1
            at += 2

        if distance > len(out):
            return None
        for _ in range(length):
            out.append(out[-distance])
    return bytes(out[:size])


def read_header(data):
    if len(data) < 0x20 or struct.unpack(">I", data[:4])[0] != 0x20:
        raise SystemExit("not a WAD: the header does not start with its own size")
    kind, _version = struct.unpack(">HH", data[4:8])
    certs, crl, ticket, tmd, contents, footer = struct.unpack(">IIIIII", data[8:0x20])
    return kind, certs, crl, ticket, tmd, contents, footer


def issuer(blob):
    """The signer's name, which says whether a blob is a ticket or a TMD."""
    return blob[SIGNATURE:SIGNATURE + 0x40].split(b"\0")[0].decode("ascii", "replace")


def sections(data):
    """The ticket and the TMD, whichever order this WAD keeps them in."""
    kind, certs, crl, ticket_size, tmd_size, _contents, _footer = read_header(data)
    at = align(0x20) + align(certs) + align(crl)

    first = data[at:at + ticket_size]
    second = data[align(at + ticket_size):align(at + ticket_size) + tmd_size]
    if "-XS" in issuer(first):
        ticket, tmd = first, second
        end = align(align(at + ticket_size) + tmd_size)
    else:
        # boot2 keeps its TMD first, and the sizes belong to the sections as
        # laid out rather than to the order the header implies.
        tmd = data[at:at + tmd_size]
        ticket = data[align(at + tmd_size):align(at + tmd_size) + ticket_size]
        end = align(align(at + tmd_size) + ticket_size)
    return kind, ticket, tmd, end


# Keys other than the console's own are not in this repository. A title that
# wants one reads it from a file you provide: one "<index> <32 hex digits>" per
# line.
KEY_FILE = os.path.expanduser("~/.wii-nx/common-keys")


def common_key(index):
    """The common key a ticket names, or None when it is not to hand."""
    if index == 0:
        return COMMON_KEY
    if not os.path.exists(KEY_FILE):
        return None
    with open(KEY_FILE) as handle:
        for line in handle:
            parts = line.split()
            if len(parts) == 2 and parts[0].isdigit() and int(parts[0]) == index:
                return bytes.fromhex(parts[1])
    return None


def key_index(ticket):
    """Which common key the ticket names.

    Plenty of WADs in circulation were repacked by tools that left rubbish in
    the reserved bytes around this one, so anything that is not a key the Wii
    actually has means the ordinary one.
    """
    index = ticket[SIGNATURE + 0xB1]
    return index if index <= 2 else 0


def title_key(ticket):
    """The ticket's key, unwrapped with the common key it names."""
    wrapped = ticket[SIGNATURE + 0x7F:SIGNATURE + 0x8F]
    title_id = ticket[SIGNATURE + 0x9C:SIGNATURE + 0xA4]
    index = key_index(ticket)
    key = common_key(index)
    if key is None:
        raise SystemExit(
            f"this title wants common key {index}: put it in {KEY_FILE} as "
            f"\"{index} <32 hex digits>\"")
    return aes_cbc_decrypt(key, title_id + b"\0" * 8, wrapped)


def boot_index(tmd):
    """Which content the title starts at, as the TMD says."""
    return struct.unpack(">H", tmd[SIGNATURE + 0xA0:SIGNATURE + 0xA2])[0]


def contents(tmd):
    """[(index, content id, type, size, sha1)] in the order the TMD lists them."""
    count = struct.unpack(">H", tmd[SIGNATURE + 0x9E:SIGNATURE + 0xA0])[0]
    records = []
    for i in range(count):
        at = SIGNATURE + 0xA4 + i * 0x24
        cid, index, kind, size = struct.unpack(">IHHQ", tmd[at:at + 0x10])
        records.append((index, cid, kind, size, tmd[at + 0x10:at + 0x24]))
    return records


def describe(data):
    kind, ticket, tmd, _end = sections(data)
    title_id = struct.unpack(">Q", tmd[SIGNATURE + 0x4C:SIGNATURE + 0x54])[0]
    version = struct.unpack(">H", tmd[SIGNATURE + 0x9C:SIGNATURE + 0x9E])[0]
    ios = struct.unpack(">Q", tmd[SIGNATURE + 0x44:SIGNATURE + 0x4C])[0]
    high, low = title_id >> 32, title_id & 0xFFFFFFFF
    code = low.to_bytes(4, "big")
    code = code.decode("ascii") if all(0x20 <= b < 0x7F for b in code) else ""

    print(f"{KINDS.get(kind, hex(kind))}")
    print(f"  title      {high:08x}/{low:08x}" + (f"  ({code})" if code else ""))
    print(f"  kind       {TITLE_KINDS.get(high, 'unknown')}")
    print(f"  version    {version}")
    print(f"  wants      IOS{ios & 0xFFFFFFFF}")
    print(f"  ticket     {issuer(ticket)}")
    print(f"  tmd        {issuer(tmd)}")
    boot = boot_index(tmd)
    print("  contents")
    for index, cid, ctype, size, _sha in contents(tmd):
        marks = " (shared)" if ctype & 0x8000 or ctype == 0x4001 else ""
        marks += "  <- boots here" if index == boot else ""
        print(f"    {index:>3}  {cid:08x}  {size:>10,} bytes{marks}")
    return kind, ticket, tmd


def unpack(data, folder):
    kind, ticket, tmd, at = sections(data)
    key = title_key(ticket)
    os.makedirs(folder, exist_ok=True)

    boot = boot_index(tmd)
    executable = None
    best = -1
    recognised = 0
    booted = None
    for index, cid, _ctype, size, _sha in contents(tmd):
        stored = (size + 15) & ~15
        blob = data[at:at + stored]
        at = align(at + stored)
        if len(blob) < stored:
            raise SystemExit(f"content {index} runs past the end of the file")

        iv = struct.pack(">H", index) + b"\0" * 14
        plain = aes_cbc_decrypt(key, iv, blob)[:size]

        path = os.path.join(folder, f"{cid:08x}.app")
        with open(path, "wb") as out:
            out.write(plain)
        print(f"  {os.path.basename(path)}  {size:,} bytes")

        # A content that is compressed is written out expanded as well: a
        # WiiWare title's own executable usually arrives that way.
        expanded = expand(plain)
        if expanded:
            with open(path + ".out", "wb") as out:
                out.write(expanded)
            print(f"    expanded to {len(expanded):,} bytes")
            plain = expanded

        # A decrypted content is recognisable: an executable, an archive, or
        # Nintendo's own compression. If none of them are, the key was wrong.
        if plain[:4] == b"\x55\xaa\x38\x2d" or plain[:4] in (b"ASH0", b"Yaz0", b"LZ77"):
            recognised += 1
        if index == boot and looks_like_dol(plain):
            booted = plain
        if looks_like_dol(plain):
            recognised += 1
            score = dol_score(plain)
            if score > best:
                best, executable = score, plain

    # Two executables, and the difference matters. The TMD names the content
    # IOS starts, which for WiiWare and Virtual Console is usually a small
    # loader - often one shared with other titles. The game itself is in
    # another content, which that loader reads and jumps into.
    def write(name, blob, note):
        with open(os.path.join(folder, name), "wb") as out:
            out.write(blob)
        print(f"  {name}  {len(blob):,} bytes  ({note})")

    if booted is not None:
        write("main.dol", booted, "the content the title boots")
        if executable is not None and executable is not booted:
            write("payload.dol", executable, "the largest executable here")
    elif executable is not None:
        write("main.dol", executable, "the only executable here")
    elif recognised:
        print("  no content is an executable on its own: the title's code is inside")
        print("  one of the archives (try tools/wiinx-unpack-u8 on the largest)")
    else:
        print("  nothing decrypted into anything recognisable - the title key is")
        print("  wrong, which usually means the ticket names a key not to hand")


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 2

    with open(argv[0], "rb") as handle:
        data = handle.read()

    print(f">> {argv[0]}  ({len(data):,} bytes)")
    describe(data)
    if len(argv) > 1:
        print(f">> unpacking into {argv[1]}")
        unpack(data, argv[1])
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
