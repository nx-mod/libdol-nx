#!/usr/bin/env python3
"""Turn a game's globals.json into the table its build links.

    tools/wiinx-make-globals <globals.json> <guest_globals.cpp>

globals.json names where the game keeps the SDK's own variables:

    { "vi.retraceCount": "0x80386BE4", "gx.FifoObj": "0x80343740" }

A name the game leaves out resolves to 0, which the runtime treats as unknown
(see src/cpu/include/guest_globals.h).
"""
import json
import re
import sys

NAME = re.compile(r"^[a-z0-9]+\.[A-Za-z_][A-Za-z0-9_]*$")


def main() -> int:
    if len(sys.argv) != 3:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    source, output = sys.argv[1], sys.argv[2]
    table = json.load(open(source))
    entries = []
    for name, value in sorted(table.items()):
        if not NAME.match(name):
            sys.exit(f"{source}: '{name}' is not <library>.<symbol>")
        address = int(value, 16)
        if not 0x80000000 <= address < 0x94000000:
            sys.exit(f"{source}: {name} {value} is outside guest RAM")
        entries.append((name, address))
    rows = "\n".join(f'    {{"{n}", 0x{a:08X}u}},' for n, a in entries)
    with open(output, "w") as out:
        out.write(f"""// Where this game keeps the SDK's variables. Generated by libdol-nx
// tools/wiinx-make-globals from {source}; do not edit.
#include "guest_globals.h"

namespace {{
const RuntimeGuestGlobals::Entry kGlobals[] = {{
{rows}
    {{nullptr, 0u}},
}};
struct Install {{
    Install() {{ RuntimeGuestGlobals::install(kGlobals, {len(entries)}); }}
}};
const Install g_install;
}}  // namespace
""")
    return 0


if __name__ == "__main__":
    sys.exit(main())
